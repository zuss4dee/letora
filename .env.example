# Copy to .env.local and fill in values.

# Supabase (required)
# GitHub Actions: the E2E workflow also needs these two as repository Secrets
# (same names: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY) — see .github/workflows/e2e.yml
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — Letora Assistant (CEO agent)
ANTHROPIC_API_KEY=
# Optional: Anthropic CEO model — must match API IDs (see Claude Models docs). Default: Haiku 4.5
# ANTHROPIC_CEO_MODEL=claude-haiku-4-5
# ANTHROPIC_CEO_MODEL=claude-sonnet-4-6
# Optional: faster failure + smaller replies
# ANTHROPIC_TIMEOUT_MS=25000
# ANTHROPIC_CEO_MAX_TOKENS=1024
# ANTHROPIC_CEO_MAX_TOKENS_SUMMARY=1536

# Google AI — rent chaser email drafts & other agents using Gemini
GOOGLE_AI_API_KEY=
# Optional: some LLM helpers use this name; set to same value as GOOGLE_AI_API_KEY if you use runGoogle()
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: CEO Gemini fallback output cap
# GEMINI_CEO_MAX_OUTPUT_TOKENS=1024

# Resend — outbound email (rent chaser auto-send, etc.)
RESEND_API_KEY=
# Verified sender; must be on a domain where Resend Receiving MX is active (so agency replies hit inbound + webhook)
RESEND_FROM_EMAIL=
# Svix signing secret from Resend → Webhooks — used by /api/webhooks/inbound-email (event: email.received)
RESEND_WEBHOOK_SECRET=
ADMIN_EMAIL=
# Optional: throttle repeated CEO failure alerts (ms; 0 disables that throttle)
# ADMIN_ALERT_EMAIL_COOLDOWN_MS=900000
# ADMIN_ALERT_DB_COOLDOWN_MS=600000

# App URL (production: your Vercel domain — used for Stripe return URLs)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Stripe (billing)
# Set to false to keep platform subscription Checkout at /api/stripe/create-checkout disabled (rent flows unaffected).
# STRIPE_PLATFORM_CHECKOUT_ENABLED=false
#
# Production: use live keys and live webhook secret (Dashboard → Developers → Webhooks).
# Do not deploy test (`sk_test_` / `whsec_` from CLI) keys to production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs — create three GBP monthly prices in Stripe (£19 / £39 / £79) and paste IDs (see src/lib/stripe-plans.ts)
# Example shape (replace with your Dashboard IDs):
# NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_1TFHmtABlmyq1A5cU5c6zbKr
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1TFHnAABlmyq1A5cd5Ok0CAQ
# NEXT_PUBLIC_STRIPE_LANDLORD_PRO_PRICE_ID=price_1TFHnTABlmyq1A5c5KDAkpEJ

# Cron (e.g. /api/cron/rent-chase) — set a long random secret and send as Authorization header
# CRON_SECRET=
